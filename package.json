{
   "name": "@itsliaaa/starcore",
   "version": "0.0.0-alpha.34",
   "description": "A Baileys wrapper for WhatsApp bot development with multi-session support, built-in stores, and more.",
   "main": "./lib/index.js",
   "exports": {
      ".": {
         "import": "./lib/index.mjs",
         "require": "./lib/index.js"
      }
   },
   "files": [
      "lib/**/*"
   ],
   "engines": {
      "node": ">=20"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/itsliaaa/starcore.git"
   },
   "funding": {
      "type": "donate",
      "url": "https://saweria.co/itsliaaa"
   },
   "keywords": [
      "automation",
      "baileys",
      "bot",
      "interactive-messages",
      "native-flow",
      "sticker-pack",
      "whatsapp",
      "whatsapp-api",
      "whatsapp-bot",
      "whatsapp-web"
   ],
   "homepage": "https://github.com/itsliaaa/starcore#readme",
   "author": "Lia Wynn",
   "license": "Apache-2.0",
   "dependencies": {
      "baileys": "^7.0.0-rc14"
   },
   "peerDependencies": {
      "better-sqlite3": ">=11",
      "file-type": "^21",
      "qr": "^0.7.0",
      "sharp": ">=0.33.3"
   },
   "peerDependenciesMeta": {
      "better-sqlite3": {
         "optional": true
      },
      "file-type": {
         "optional": true
      },
      "qr": {
         "optional": true
      },
      "sharp": {
         "optional": true
      }
   },
